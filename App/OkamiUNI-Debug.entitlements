<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  As permissões do app **em Debug**. `network.server` também existe em Release
  porque o OAuth PKCE do LiteLLM recebe o redirect numa porta efêmera restrita
  a 127.0.0.1; em Debug ela atende ainda o ensaio de contas abaixo.

  Ela existe por causa de um instrumento: `--ensaiar-contas` sobe o
  `RehearsalImapServer` em 127.0.0.1 numa porta que o sistema escolhe, e o
  sandbox recusa `bind` sem esta chave ("Operation not permitted", errno 1).
  Um servidor falso dentro do processo é o que faz o ensaio do fluxo de contas
  rodar num notebook desligado da internet, sem tocar servidor de ninguém.

  O receptor de produção não é um servidor genérico: faz bind apenas em
  127.0.0.1, aceita uma resposta GET limitada e se encerra após o callback.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>
  <key>com.apple.security.personal-information.calendars</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
</dict>
</plist>
