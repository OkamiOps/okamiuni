<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>pt-BR</string>
  <key>CFBundleLocalizations</key>
  <array><string>pt-BR</string><string>en</string><string>de</string><string>fr</string></array>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>OkamiUNI</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSMinimumSystemVersion</key><string>26.0</string>
  <key>NSHumanReadableCopyright</key><string>© 2026 OkamiOps</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>O OkamiUNI mostra seus compromissos ao lado dos emails e cria eventos a partir das mensagens.</string>
  <key>OkamiUNIGoogleClientID</key>
  <string>$(OKAMIUNI_GOOGLE_CLIENT_ID)</string>
  <key>OkamiUNIGoogleClientSecret</key>
  <string>$(OKAMIUNI_GOOGLE_CLIENT_SECRET)</string>
  <!-- As salas de reunião. Vêm de Config/Meetings.xcconfig, que fica fora do
       repositório; sem valor, a linha do serviço em Configurações ▸ Agendas
       diz que ele ainda não está disponível neste build e não oferece o
       botão Conectar. Ver Config/Meetings.example.xcconfig. -->
  <key>OkamiUNIZoomClientID</key>
  <string>$(OKAMIUNI_ZOOM_CLIENT_ID)</string>
  <key>OkamiUNIZoomClientSecret</key>
  <string>$(OKAMIUNI_ZOOM_CLIENT_SECRET)</string>
  <key>OkamiUNIMicrosoftClientID</key>
  <string>$(OKAMIUNI_MICROSOFT_CLIENT_ID)</string>
  <key>OkamiUNIZohoClientID</key>
  <string>$(OKAMIUNI_ZOHO_CLIENT_ID)</string>
  <key>OkamiUNIZohoClientSecret</key>
  <string>$(OKAMIUNI_ZOHO_CLIENT_SECRET)</string>
  <!-- O atualizador (Sparkle 2). Em Debug ele nunca sobe — ver
       UpdaterComposition — mas as chaves ficam aqui de todo jeito: o
       Info.plist é um só, e o SPUUpdater lê o feed e a chave pública daqui em
       vez de do código. -->

  <!-- Obrigatória num app em sandbox: o Sparkle não pode instalar de dentro
       da caixa, então ele lança o Installer.xpc embarcado no framework. Ver a
       página "Sandboxing" da documentação do Sparkle e as duas exceções de
       mach-lookup em OkamiUNI.entitlements. O Downloader.xpc NÃO é preciso:
       este app já tem com.apple.security.network.client. -->
  <key>SUEnableInstallerLauncherService</key><true/>
  <key>SUFeedURL</key><string>https://okamiops.github.io/okamiuni/appcast.xml</string>
  <!-- A chave pública EdDSA (ed25519) dos releases. A privada fica no
       Keychain de login de quem publica e nunca entra neste repositório. Um
       appcast assinado com outra chave é recusado e nada é instalado. -->
  <key>SUPublicEDKey</key><string>+pfQBbz8gIzPjZzWaqY/NCxsyvS7oBaP6ERFj2UGr3I=</string>
  <!-- Procura sozinho, sem o diálogo "deseja verificar automaticamente?" que
       o Sparkle mostraria na primeira abertura. A pessoa pode desligar isto em
       Configurações ▸ Geral ▸ Atualizações. -->
  <key>SUEnableAutomaticChecks</key><true/>
  <!-- Seis horas, em segundos. -->
  <key>SUScheduledCheckInterval</key><integer>21600</integer>

  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.okamiops.okamiuni.oauth</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>com.okamiops.okamiuni</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
